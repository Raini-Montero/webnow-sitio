# Puerto del backend (API del formulario)
PORT=3001

# Correo que recibe los mensajes del formulario
CONTACT_TO=contacto@webnow.cl

# SMTP para enviar los mensajes por correo (opcional).
# Si se deja vacío, los mensajes solo se guardan en server/data/leads.jsonl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="webnow <no-reply@webnow.cl>"
